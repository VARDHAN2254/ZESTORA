# ==============================================
# ZESTORA Environment Configuration Example
# ==============================================

# API Configuration (apps/api)
API_HOST=127.0.0.1
API_PORT=8000
API_ENV=development
API_DEBUG=true
API_CORS_ORIGINS=["http://localhost:3000"]

# Web Frontend Configuration (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Worker Configuration (apps/worker)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Database Configuration (Future Phases)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zestora_dev

# Cache & Real-Time (Future Phases)
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET=replace-with-a-secure-secret-key-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
